package sd4components.correct;

sequencediagram Example {

  a:A;
  a1:A;
  b:B;
  b1:B;
  c1:C;
  c2:C;
  c; // No type

  let int m = 0;

  -> a.pIn : trigger m;
  a.pOut -> b.pIn : ...;
  a.pOut -> c1.pIn : m + 2;
  c1.pOut -> c2.pOut : 4;

  Tick;

  Tick{
  }

  assert c2.pOut == 4;
}
